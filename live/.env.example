# Copy this file to ".env" (same folder) and fill it in. NEVER commit or share ".env".

# ---- YouTube live chat (read comments + likes) ----
YT_API_KEY=
YT_VIDEO_ID=
# Each chat poll costs YouTube quota; 10000ms is ~5.5h/day on the default quota.
YT_MIN_POLL_MS=10000

# ---- Razorpay ----
# Your Payment Page / Payment Link URL. Used for the QR, the red UPI button, and the link you PIN in live chat.
RAZORPAY_PAY_URL=
# Webhook secret you type when creating the webhook (event: payment.captured).
RAZORPAY_WEBHOOK_SECRET=
# API keys (Dashboard > Account & Settings > API Keys). With these, every payment is re-checked
# with Razorpay before it is shown (status must be "captured" and the amount must match).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: exact key inside payment "notes" that holds the name (server logs the keys it sees).
RAZORPAY_NAME_FIELD=

# ---- Support asks (minutes) ----
PROMO_FIRST_MIN=5
PROMO_MIN=10
PROMO_MAX=20
PROMO_AFTER_DONATION_MIN=5

# ---- Voice ----
# kokoro = local soft Hindi female voice (default). Run "npm run voicepack" once (~10 min) so idle talk plays instantly.
#          KOKORO_VOICE: hf_beta or hf_alpha (both female Hindi). KOKORO_SPEED 0.9 = soft, slow late-night delivery.
# edge = free online Swara | azure = official Swara | google = Chirp HD | elevenlabs = most expressive (paid)
TTS_PROVIDER=kokoro
KOKORO_VOICE=hf_beta
KOKORO_SPEED=0.9
# seconds of silence between lines when nothing else is happening
COMMENTARY_GAP_SEC=2
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
GOOGLE_TTS_KEY=
# e.g. a hi-IN Chirp3-HD voice name from Google's voice list
GOOGLE_TTS_VOICE=
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# ---- Host name (spoken in Hindi) ----
HOST_NAME_HI=रिया

PORT=8787




# YouTube Data API v3 key: everything style_intel / yt_intel read (metadata, stats, playlists)

# OAuth "installed app" client: only needed for actions on YOUR channel (e.g. a future auto-upload step).
# Not used by the current pipeline — the API key above covers all reading.

# YouTube OAuth (optional: finds today's live video automatically and can post the support link in chat)
YOUTUBE_OAUTH_CLIENT_JSON=
YT_REFRESH_TOKEN=
